# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional, free tier at https://app.tavily.com. Lets you paste an article link instead of text,
# and lets each editor search for hashtags in current use before drafting.
TAVILY_API_KEY=

# Any "provider/model" string. Gemini and OpenAI work out of the box; for Anthropic, Groq,
# Ollama and the rest of LiteLLM's providers run `uv sync --extra providers` and set their key.
MODEL=gemini/gemini-3.8-flash
